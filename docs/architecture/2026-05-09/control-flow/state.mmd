%% Control flow — persistence coordinator state machine + LLM call lifecycle.
%% Date: 2026-05-09

stateDiagram-v2
    [*] --> Idle: app construct

    state "Persistence Coordinator" as Coord {
        Idle --> Bootstrapping: bootstrap(workspaceId)
        Bootstrapping --> Ready: snapshot loaded + normalized + validated
        Bootstrapping --> Error: load fails
        Bootstrapping --> Offline: load fails (FacetApiError code='offline')
        Ready --> Saving: saveWorkspacePatch / importWorkspaceSnapshot
        Saving --> Saved: backend write succeeds
        Saving --> Error: backend write fails (non-offline)
        Saving --> Offline: backend write fails (offline)
        Saved --> Ready: next operation
        Error --> Bootstrapping: retry bootstrap
        Offline --> Bootstrapping: connectivity restored, retry
    }

